@startuml AppointmentSchedulingSystem

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package domain {
    class User {
        - id: String
        - name: String
        - email: String
        - password: String
        + isAdmin(): boolean
    }

    class Administrator {
        + isAdmin(): boolean
    }

    class TimeSlot {
        - startTime: LocalDateTime
        - endTime: LocalDateTime
        + overlapsWith(TimeSlot): boolean
    }

    abstract class Appointment {
        - id: String
        - status: String
        - participantCount: int
        - patient: User
        - timeSlot: TimeSlot
    }

    class InPersonAppointment {
        - location: String
    }

    class VirtualAppointment {
        - meetingLink: String
    }

    class FollowUpAppointment
    class AssessmentAppointment
    class GroupAppointment {
        - maxCapacity: int
    }
    class IndividualAppointment
    class UrgentAppointment

    class Schedule {
        - appointments: List<Appointment>
        + getOverlappingAppointments(TimeSlot): List<Appointment>
    }

    class NotificationMessage {
        - subject: String
        - content: String
        - timestamp: LocalDateTime
    }

    Administrator --|> User
    InPersonAppointment --|> Appointment
    VirtualAppointment --|> Appointment
    FollowUpAppointment --|> Appointment
    AssessmentAppointment --|> Appointment
    GroupAppointment --|> Appointment
    IndividualAppointment --|> Appointment
    UrgentAppointment --|> Appointment

    Appointment --> User
    Appointment --> TimeSlot
    Schedule "1" o-- "*" Appointment
}

package "domain.rules" {
    interface BookingRuleStrategy {
        + isValid(Appointment): boolean
    }

    class DurationRuleStrategy
    class CapacityRuleStrategy
    class AppointmentTypeRuleStrategy

    DurationRuleStrategy ..|> BookingRuleStrategy
    CapacityRuleStrategy ..|> BookingRuleStrategy
    AppointmentTypeRuleStrategy ..|> BookingRuleStrategy
}

package "domain.notifiers" {
    interface Observer {
        + notify(User, String)
    }

    class EmailNotifier
    class CalendarNotifier

    EmailNotifier ..|> Observer
    CalendarNotifier ..|> Observer
}

package persistence {
    interface UserRepository {
        + save(User)
        + findByEmail(String): Optional<User>
    }

    interface AppointmentRepository {
        + save(Appointment)
        + findById(String): Optional<Appointment>
        + deleteById(String)
    }

    class InMemoryUserRepository
    class InMemoryAppointmentRepository

    InMemoryUserRepository ..|> UserRepository
    InMemoryAppointmentRepository ..|> AppointmentRepository
}

package application {
    class AuthService {
        + login(String, String): boolean
    }

    class BookingService {
        + bookAppointment(Appointment): boolean
        + cancelAppointment(String, User): boolean
        + modifyAppointment(String, User, TimeSlot): boolean
    }

    class ScheduleService {
        + getAvailableSlots(LocalDate): List<TimeSlot>
    }

    class NotificationService {
        + attach(Observer)
        + notifyAllObservers(User, String)
    }

    AuthService --> UserRepository
    BookingService --> AppointmentRepository
    BookingService --> ScheduleService
    BookingService --> NotificationService
    BookingService --> BookingRuleStrategy
    ScheduleService --> AppointmentRepository
    NotificationService --> Observer
    NotificationService --> NotificationMessage
}

package presentation {
    class MainApp
    class LoginController
    class PatientDashboardController
    class AdminDashboardController
    class BookAppointmentController
    class ModifyAppointmentController

    MainApp --> AuthService
    MainApp --> BookingService
    MainApp --> ScheduleService
    MainApp --> NotificationService

    LoginController --> AuthService
    PatientDashboardController --> BookingService
    AdminDashboardController --> BookingService
    BookAppointmentController --> BookingService
    ModifyAppointmentController --> BookingService
}

@enduml