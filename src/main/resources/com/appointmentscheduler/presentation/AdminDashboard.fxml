            </padding>
            <VBox spacing="6" >
                <VBox.margin><Insets bottom="24.0" /></VBox.margin>
                <Label styleClass="sidebar-title" text="Admin Workspace" />
                <Label styleClass="sidebar-subtitle" text="Universal Booking Platform" />
            </VBox>
            
            <Button fx:id="btnNavDashboard" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleNavDashboard" styleClass="sidebar-btn, sidebar-btn-active" text="Overview Dashboard">
                <graphic><SVGPath content="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z" styleClass="icon" scaleX="1.1" scaleY="1.1"/></graphic>
            </Button>
            <Button fx:id="btnNavAppointments" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleNavAppointments" styleClass="sidebar-btn" text="Manage Appointments">
                <graphic><SVGPath content="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11z" styleClass="icon" scaleX="1.1" scaleY="1.1"/></graphic>
            </Button>
            <Button fx:id="btnNavUsers" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleNavUsers" styleClass="sidebar-btn" text="عملاء الحجوزات / Booking clients">
                <graphic><SVGPath content="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" styleClass="icon" scaleX="1.1" scaleY="1.1"/></graphic>
            </Button>
            <Button fx:id="btnNavReports" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleNavReports" styleClass="sidebar-btn" text="Reports &amp; Analytics">
                <graphic><SVGPath content="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z" styleClass="icon" scaleX="1.1" scaleY="1.1"/></graphic>
            </Button>
            <Button fx:id="btnNavSettings" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleNavSettings" styleClass="sidebar-btn" text="System Settings">
                <graphic><SVGPath content="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.06-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.73,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.06,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.43-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.49-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z" styleClass="icon" scaleX="1.1" scaleY="1.1"/></graphic>
            </Button>
            <Button fx:id="btnNavAudit" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleNavAudit" styleClass="sidebar-btn" text="Audit Log">
                <graphic><SVGPath content="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z" styleClass="icon" scaleX="1.1" scaleY="1.1"/></graphic>
            </Button>
            <Button fx:id="btnNavMessaging" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleNavMessaging" styleClass="sidebar-btn" text="Notifications / إشعارات">
                <graphic><SVGPath content="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z" styleClass="icon" scaleX="1.1" scaleY="1.1"/></graphic>
            </Button>
            <Button fx:id="btnNavAppointmentTypes" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleNavAppointmentTypes" styleClass="sidebar-btn" text="أنواع المواعيد" />
            <Button fx:id="btnNavBranches" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleNavBranches" styleClass="sidebar-btn" text="Locations / المواقع" />
            
            <VBox alignment="BOTTOM_CENTER" VBox.vgrow="ALWAYS" spacing="10">
                <Label styleClass="sidebar-footer-shortcuts" text="F5 Refresh · Ctrl+Q Logout" />
                <Label fx:id="adminFooterVersionLabel" styleClass="sidebar-subtitle" style="-fx-font-size: 11px; -fx-opacity: 0.8;" />
                <Button fx:id="btnThemeToggle" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleToggleTheme" styleClass="button-export" text="Switch Theme" />
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleLogout" styleClass="button-danger" text="Logout" />
            </VBox>
        </VBox>
    </left>
    
    <!-- MAIN CONTENT AREA (SPA) - Enterprise workspace -->
    <center>
        <VBox fx:id="adminWorkspace" styleClass="admin-workspace" alignment="TOP_CENTER" BorderPane.alignment="CENTER" VBox.vgrow="ALWAYS">
            <HBox styleClass="admin-topbar" alignment="CENTER_LEFT" spacing="20">
                <StackPane styleClass="user-avatar" style="-fx-background-radius: 50%; -fx-min-width: 40; -fx-min-height: 40; -fx-background-color: #0d9488;">
                    <Label fx:id="adminInitialsLabel" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;" />
                </StackPane>
                <Label text="Location / الموقع:" styleClass="stat-label"/>
                <ComboBox fx:id="clinicSelectorCombo" prefWidth="200.0" promptText="All sites" styleClass="combo-box" />
                <Label fx:id="adminSessionLabel" styleClass="admin-session-info" text="" />
                <Region HBox.hgrow="ALWAYS" />
                <HBox fx:id="notificationBarPlaceholder" alignment="CENTER_RIGHT" spacing="8" />
                <Button fx:id="btnShortcutsAdmin" mnemonicParsing="false" onAction="#handleShowShortcutsAdmin" styleClass="header-icon-btn shortcut-btn-icon" minWidth="44" minHeight="44" maxWidth="44" maxHeight="44">
                    <tooltip><Tooltip text="Keyboard shortcuts" /></tooltip>
                    <graphic>
                        <SVGPath content="M11 18h2v-2h-2v2zm1-16C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm.31-8c0 1.1-.9 2-2 2s-2-.9-2-2 .9-2 2-2 2 .9 2 2zm-.01 6c0 .55-.45 1-1 1s-1-.45-1-1 .45-1 1-1 1 .45 1 1z" styleClass="icon" scaleX="1.1" scaleY="1.1"/>
                    </graphic>
                </Button>
                <Button fx:id="btnLogout" mnemonicParsing="false" onAction="#handleLogout" styleClass="button-danger" text="تسجيل الخروج / Logout" />
            </HBox>
        <ScrollPane fx:id="adminScrollPane" styleClass="admin-scroll-pane" fitToWidth="true" VBox.vgrow="ALWAYS">
            <StackPane fx:id="contentArea" styleClass="content-area admin-content">
                <padding>
                    <Insets bottom="32.0" left="40.0" right="40.0" top="28.0" />
                </padding>
            
            <!-- VIEW 1: DASHBOARD OVERVIEW -->
            <VBox fx:id="dashboardView" spacing="28.0" styleClass="admin-dashboard-view">
                <HBox styleClass="breadcrumbs admin-breadcrumbs" alignment="CENTER_LEFT">
                    <Label text="Admin Portal" styleClass="breadcrumb-text"/>
                    <Label text=" / " styleClass="breadcrumb-arrow"/>
                    <Label text="Overview Dashboard" styleClass="breadcrumb-text, breadcrumb-active"/>
                </HBox>
                <HBox styleClass="admin-page-header" alignment="CENTER_LEFT" spacing="20.0">
                    <Label fx:id="welcomeLabel" styleClass="admin-page-title" text="Dashboard Overview" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="dashboardLastUpdatedLabel" styleClass="admin-meta-label" text="Last synced: —" />
                    <HBox alignment="CENTER_RIGHT" spacing="10">
                        <Button fx:id="btnRefreshAdmin" mnemonicParsing="false" onAction="#handleRefreshAdmin" styleClass="button-export" text="Refresh">
                            <graphic><SVGPath content="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" styleClass="icon" scaleX="1.0" scaleY="1.0"/></graphic>
                        </Button>
                        <Button fx:id="btnExportCsv" mnemonicParsing="false" onAction="#handleExport" styleClass="button-export" text="Export CSV" />
                        <Button fx:id="btnExportHtmlReport" mnemonicParsing="false" onAction="#handleExportHtmlReport" styleClass="button-export" text="Export Report (HTML)" />
                    </HBox>
                </HBox>

                <VBox fx:id="adminAlertsPanel" styleClass="admin-alerts-panel" spacing="8" visible="false" managed="false">
                    <Label styleClass="admin-alerts-title" text="تنبيهات / Alerts" />
                    <HBox fx:id="adminAlertsContent" alignment="CENTER_LEFT" spacing="12" />
                </VBox>

                <VBox styleClass="admin-kpi-section" spacing="12">
                    <VBox styleClass="enterprise-module-heading" spacing="4">
                        <Label styleClass="enterprise-module-eyebrow" text="Operations · العمليات" />
                        <Label styleClass="admin-kpi-section-title" text="مؤشرات الأداء / Key performance metrics" />
                    </VBox>
                    <VBox styleClass="enterprise-metrics-panel">
                        <GridPane hgap="0.0" vgap="0.0" styleClass="enterprise-metrics-grid">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" minWidth="120" prefWidth="200" />
                            <ColumnConstraints hgrow="ALWAYS" minWidth="120" prefWidth="200" />
                            <ColumnConstraints hgrow="ALWAYS" minWidth="120" prefWidth="200" />
                            <ColumnConstraints hgrow="ALWAYS" minWidth="120" prefWidth="200" />
                            <ColumnConstraints hgrow="ALWAYS" minWidth="120" prefWidth="200" />
                            <ColumnConstraints hgrow="ALWAYS" minWidth="120" prefWidth="200" />
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints vgrow="ALWAYS" minHeight="140" prefHeight="140" />
                        </rowConstraints>
                        <StackPane styleClass="enterprise-metric-cell" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS">
                            <VBox alignment="TOP_LEFT" spacing="0" StackPane.alignment="TOP_LEFT">
                                <padding><Insets left="22" top="22" right="18" bottom="22" /></padding>
                                <Label styleClass="enterprise-metric-caption" text="عدد المواعيد اليوم / Today" />
                                <Label fx:id="todayApptsLabel" styleClass="enterprise-metric-value" text="0" />
                                <Label fx:id="todayTrendLabel" styleClass="enterprise-metric-delta" text="" />
                            </VBox>
                        </StackPane>
                        <StackPane styleClass="enterprise-metric-cell" GridPane.columnIndex="1" GridPane.rowIndex="0" GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS">
                            <VBox alignment="TOP_LEFT" spacing="0" StackPane.alignment="TOP_LEFT">
                                <padding><Insets left="22" top="22" right="18" bottom="22" /></padding>
                                <Label styleClass="enterprise-metric-caption" text="هذا الأسبوع / This week" />
                                <Label fx:id="weekApptsLabel" styleClass="enterprise-metric-value" text="0" />
                                <Label fx:id="weekTrendLabel" styleClass="enterprise-metric-delta" text="" />
                            </VBox>
                        </StackPane>
                        <StackPane styleClass="enterprise-metric-cell enterprise-metric-cell-cancellation" GridPane.columnIndex="2" GridPane.rowIndex="0" GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS">
                            <VBox alignment="TOP_LEFT" spacing="6" StackPane.alignment="TOP_LEFT">
                                <padding><Insets left="22" top="18" right="18" bottom="18" /></padding>
                                <Label styleClass="enterprise-metric-caption" text="نسبة الإلغاء / Cancellation rate" />
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label fx:id="cancellationRateLabel" styleClass="enterprise-metric-value cancellation-rate-value" text="0.0%" />
                                </HBox>
                                <ProgressBar fx:id="cancellationRateProgressBar" minWidth="120" maxWidth="Infinity" prefWidth="200" styleClass="cancellation-rate-progress" progress="0.0" />
                                <Label fx:id="cancellationRateStatusLabel" styleClass="cancellation-rate-status-label" text="—" wrapText="true" />
                            </VBox>
                        </StackPane>
                        <StackPane styleClass="enterprise-metric-cell" GridPane.columnIndex="3" GridPane.rowIndex="0" GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS">
                            <VBox alignment="TOP_LEFT" spacing="0" StackPane.alignment="TOP_LEFT">
                                <padding><Insets left="22" top="22" right="18" bottom="22" /></padding>
                                <Label styleClass="enterprise-metric-caption" text="أكثر وقت مزدحم / Peak hour" />
                                <Label fx:id="peakHourLabel" styleClass="enterprise-metric-value" text="—" />
                            </VBox>
                        </StackPane>
                        <StackPane styleClass="enterprise-metric-cell" GridPane.columnIndex="4" GridPane.rowIndex="0" GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS">
                            <VBox alignment="TOP_LEFT" spacing="0" StackPane.alignment="TOP_LEFT">
                                <padding><Insets left="22" top="22" right="18" bottom="22" /></padding>
                                <Label styleClass="enterprise-metric-caption" text="إجمالي الحجوزات / Total bookings" />
                                <Label fx:id="totalApptsLabel" styleClass="enterprise-metric-value" text="0" />
                            </VBox>
                        </StackPane>
                        <StackPane styleClass="enterprise-metric-cell enterprise-metric-cell-cancelled enterprise-metric-cell-last" GridPane.columnIndex="5" GridPane.rowIndex="0" GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS">
                            <VBox alignment="TOP_LEFT" spacing="4" StackPane.alignment="TOP_LEFT">
                                <padding><Insets left="22" top="18" right="22" bottom="18" /></padding>
                                <Label styleClass="enterprise-metric-caption" text="ملغاة / Cancelled" />
                                <Label fx:id="cancelledApptsLabel" styleClass="enterprise-metric-value cancelled-appts-count" text="0" />
                                <Label styleClass="cancelled-appts-footnote" text="إجمالي المواعيد بحالة ملغاة · Total with cancelled status" wrapText="true" />
                            </VBox>
                        </StackPane>
                        </GridPane>
                    </VBox>
                </VBox>
                <VBox fx:id="executiveKpiContainer" spacing="0.0" styleClass="admin-card executive-kpi-section">
                    <VBox styleClass="enterprise-module-heading enterprise-module-heading-inset" spacing="4">
                        <Label styleClass="enterprise-module-eyebrow" text="Governance · الحوكمة" />
                        <Label styleClass="admin-section-title executive-kpi-main-title" text="مؤشرات تنفيذية / Executive KPIs" />
                        <Label styleClass="admin-kpi-section-subtitle executive-kpi-sub" text="عتبات التنبيه · Warning &amp; critical thresholds" />
                    </VBox>
                    <VBox styleClass="enterprise-executive-panel">
                        <HBox fx:id="executiveKpiBox" styleClass="executive-kpi-row" spacing="0" />
                    </VBox>
                </VBox>
                <VBox spacing="16.0" styleClass="admin-card" VBox.vgrow="ALWAYS">
                    <HBox styleClass="calendar-toolbar" alignment="CENTER_LEFT" spacing="15.0">
                        <Label styleClass="admin-section-title" text="عرض المواعيد / Schedule Calendar" />
                        <ComboBox fx:id="calendarViewModeCombo" styleClass="combo-box" prefWidth="140.0" promptText="View" />
                        <Button fx:id="btnCalendarPrev" styleClass="calendar-nav-btn" mnemonicParsing="false" onAction="#handleCalendarPrev" text="◀" />
                        <Label fx:id="calendarRangeLabel" styleClass="stat-label calendar-range-label" text="—" />
                        <Button fx:id="btnCalendarNext" styleClass="calendar-nav-btn" mnemonicParsing="false" onAction="#handleCalendarNext" text="▶" />
                        <Region HBox.hgrow="ALWAYS" />
                    </HBox>
                    <VBox fx:id="calendarContainer" styleClass="calendar-container" VBox.vgrow="ALWAYS"/>
                </VBox>
                <VBox spacing="0.0" styleClass="admin-card closed-day-card">
                    <HBox alignment="TOP_LEFT" spacing="0.0" styleClass="closed-day-layout">
                        <HBox alignment="TOP_LEFT" spacing="14.0" styleClass="closed-day-lead" HBox.hgrow="ALWAYS">
                            <StackPane styleClass="closed-day-icon-badge" minWidth="56" minHeight="56" maxWidth="56" maxHeight="56">
                                <SVGPath content="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z" styleClass="closed-day-icon-glyph" scaleX="1.0" scaleY="1.0" />
                            </StackPane>
                            <VBox spacing="8.0" styleClass="closed-day-copy">
                                <Label styleClass="enterprise-module-eyebrow" text="Operations · العمليات" />
                                <Label styleClass="closed-day-title" text="إغلاق يوم كامل / Close full day" wrapText="true" />
                                <Label styleClass="closed-day-subtitle" text="يمنع الحجز في التاريخ المحدد ويُبلّغ العملاء فوراً عبر مركز الإشعارات والقنوات المفعّلة." wrapText="true" />
                                <VBox styleClass="closed-day-meta-strip">
                                    <Label styleClass="closed-day-meta-text" text="إشعار فوري للعملاء · تسجيل في سجل التدقيق · Instant notifications &amp; audit trail" wrapText="true" />
                                </VBox>
                            </VBox>
                        </HBox>
                        <Region styleClass="closed-day-divider" prefWidth="1" minHeight="120" maxHeight="Infinity" />
                        <VBox spacing="0.0" styleClass="closed-day-panel" minWidth="300.0" prefWidth="352.0" maxWidth="380.0">
                            <VBox spacing="4.0" styleClass="closed-day-panel-head">
                                <Label styleClass="closed-day-panel-kicker" text="ACTION MODULE" />
                                <Label styleClass="closed-day-panel-title" text="التاريخ · Date" />
                            </VBox>
                            <VBox spacing="8.0" styleClass="closed-day-panel-body">
                                <VBox styleClass="closed-day-input-wrap">
                                    <DatePicker fx:id="closedDayDatePicker" styleClass="combo-box closed-day-datepicker" maxWidth="Infinity" />
                                </VBox>
                                <HBox alignment="CENTER" spacing="10.0" styleClass="closed-day-actions">
                                    <Button fx:id="btnReopenDay" mnemonicParsing="false" onAction="#handleReopenDay" styleClass="button closed-day-btn-open" text="فتح اليوم" maxWidth="Infinity" minHeight="44.0">
                                        <graphic>
                                            <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" styleClass="closed-day-btn-icon" scaleX="1.0" scaleY="1.0" />
                                        </graphic>
                                    </Button>
                                    <Button fx:id="btnCloseDay" mnemonicParsing="false" onAction="#handleCloseDay" styleClass="button closed-day-btn-close" text="إغلاق اليوم" maxWidth="Infinity" minHeight="44.0">
                                        <graphic>
                                            <SVGPath content="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z" styleClass="closed-day-btn-icon" scaleX="1.0" scaleY="1.0" />
                                        </graphic>
