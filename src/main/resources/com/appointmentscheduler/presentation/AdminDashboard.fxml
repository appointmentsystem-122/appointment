                            <TextField fx:id="searchField" prefWidth="250.0" promptText="Search (Ctrl+F)..." styleClass="search-field" />
                        </HBox>
                    </HBox>
                    
                    <VBox VBox.vgrow="ALWAYS" spacing="10">
