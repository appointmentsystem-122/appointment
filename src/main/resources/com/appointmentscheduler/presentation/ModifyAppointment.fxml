<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

<BorderPane prefHeight="800.0" prefWidth="1280.0" styleClass="root, login-bg" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.appointmentscheduler.presentation.ModifyAppointmentController">
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="app-bar">
            <Label text="Enterprise Appointment System" style="-fx-text-fill: #e2e8f0; -fx-font-size: 16px; -fx-font-weight: 700;"/>
            <Region HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#handleBack" styleClass="button-export" text="رجوع / Back" />
            <Button mnemonicParsing="false" onAction="#handleLogout" styleClass="button-danger" text="تسجيل الخروج / Logout" />
        </HBox>
    </top>
    <center>
        <StackPane>
            <VBox alignment="CENTER" maxWidth="480.0" spacing="32.0" styleClass="login-card">
                <VBox alignment="CENTER" spacing="8">
                    <Label styleClass="label-title" text="Modify Appointment" />
                    <Label fx:id="currentApptLabel" text="Loading appointment details..." style="-fx-text-fill: #64748b; -fx-font-size: 14px; -fx-font-weight: 600;"/>
                </VBox>
                <VBox spacing="18.0" maxWidth="400">
                    <Label text="New Date" styleClass="stat-label"/>
                    <DatePicker fx:id="datePicker" maxWidth="1.7976931348623157E308" onAction="#handleDateSelection" styleClass="date-picker"/>
                    <Label text="New Time Slot" styleClass="stat-label">
                        <VBox.margin><Insets top="12" /></VBox.margin>
                    </Label>
                    <ComboBox fx:id="timeSlotCombo" maxWidth="1.7976931348623157E308" promptText="Choose a time slot" styleClass="combo-box"/>
                </VBox>
                <VBox alignment="CENTER" spacing="16" maxWidth="400">
                    <HBox alignment="CENTER_RIGHT" spacing="12">
                        <Button mnemonicParsing="false" onAction="#handleBack" styleClass="button-export" text="Cancel" />
                        <Button fx:id="btnSubmitModify" mnemonicParsing="false" onAction="#handleModify" styleClass="button-primary" text="تأكيد التعديل / Confirm Changes" disable="true" />
                    </HBox>
                    <Label fx:id="messageLabel" styleClass="error-label"/>
                </VBox>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
